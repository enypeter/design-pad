{
  "name": "@design-pad/embed",
  "version": "0.1.0",
  "description": "Host-side SDK to embed the hosted Design Pad editor in an iframe, plus the shared bridge protocol.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js"
      },
      "./protocol": {
        "types": "./dist/types/protocol.d.ts",
        "import": "./dist/protocol.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "vite": "8.3.5"
  }
}
