{
  "name": "design-pad",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @design-pad/web dev",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter @design-pad/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @design-pad/web test:e2e",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
